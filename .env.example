# MGOO Omnichannel Desk Environment Variables Example
# Duplicate this file to .dev.vars for local development

SALESMARTLY_PROJECT_ID=
SALESMARTLY_API_TOKEN=
SALESMARTLY_WEBHOOK_SECRET=
SALESMARTLY_WEBHOOK_TOKEN=
SALESMARTLY_REPLY_MODE=draft

# AI Engine (DeepSeek / OpenAI)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Codex Gateway (Optional)
CODEX_GATEWAY_URL=http://127.0.0.1:4000
CODEX_GATEWAY_TOKEN=
CODEX_MODEL=deepseek-chat

# ECCANG ERP (Optional)
ECCANG_APP_KEY=
ECCANG_APP_SECRET=
ECCANG_SERVICE_URL=https://open.eccang.com/api
ECCANG_USER_TOKEN=
